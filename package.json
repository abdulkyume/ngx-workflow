{
  "name": "ngx-workflow",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build ngx-workflow --configuration production",
    "build:web": "ng build ngx-workflow-web --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:lib": "ng test ngx-workflow --no-watch --browsers=ChromeHeadless",
    "lint": "npx tsc -p libs/ngx-workflow/tsconfig.lib.json --noEmit --inlineSources false",
    "format": "npx prettier --write \"libs/ngx-workflow/src/**/*.{ts,html,scss}\" \"src/**/*.{ts,html,scss}\"",
    "pack:lib": "npm run build:lib && npm pack ./dist/ngx-workflow"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "elkjs": "^0.11.0",
    "gsap": "^3.15.0",
    "marked": "^17.0.1",
    "rxjs": "~7.8.0",
    "three": "^0.185.1",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.3",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@types/jasmine": "~5.1.0",
    "@types/marked": "^5.0.2",
    "@types/three": "^0.185.4",
    "@types/uuid": "^10.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.1.1",
    "typescript": "~6.0.3"
  }
}
